{
  "name": "create-scripts-for-videos",
  "version": "0.1.0",
  "type": "module",
  "module": "src/cli/index.ts",
  "scripts": {
    "start": "bun run src/cli/index.ts watch",
    "once": "bun run src/cli/index.ts run-once",
    "test": "bun test --preload ./tests/setup.ts tests/**/*.test.ts",
    "test:unit": "bun test --preload ./tests/setup.ts ./tests/config/ ./tests/sdk/ ./tests/services/ ./tests/utils/ ./tests/video/",
    "test:integration": "bun test --preload ./tests/setup.ts tests/integration/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "playwright": "1.55.1",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
