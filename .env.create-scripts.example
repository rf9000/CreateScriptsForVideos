# Copy to .env.create-scripts on the VM (next to docker-compose.yml) and fill in.
# Only secrets / per-deployment values belong here — container paths live in docker-compose.yml.

# Azure DevOps (required)
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_ORG=continia-software
AZURE_DEVOPS_PROJECT=Continia Software

# Scope discovery to an area path (WIQL UNDER — node + descendants). This is how
# Continia Banking items are classified. Empty = every tagged item in the project.
AZURE_DEVOPS_AREA_PATH=Continia Software\Continia Banking

# continia.exe / continia-linux auth token (required; passed as --token by the skills)
CONTINIA_API_TOKEN=

# Anthropic API key for the agent (required on the VM — the container runs on API
# billing; there is no ~/.claude OAuth mount).
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# CREATE_SCRIPT_TAG=create script
# POLL_INTERVAL_MINUTES=5
# WATCH_CONCURRENCY=1  # >1 assumes the agent's skills don't contend on shared repo-root state; only 1 has been verified in production.
# AGENT_MAX_TURNS=200
# CLAUDE_MODEL=claude-sonnet-4-6
