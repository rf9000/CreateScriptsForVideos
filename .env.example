# Azure DevOps Configuration (required)
AZURE_DEVOPS_PAT=your-pat-here
AZURE_DEVOPS_ORG=continia-software
AZURE_DEVOPS_PROJECT=Continia Software

# Scope discovery to an area path (WIQL UNDER — matches the node and all
# descendants). This is how Continia Banking work items are classified (NOT via
# Git links). Leave empty to process every tagged item in the project.
AZURE_DEVOPS_AREA_PATH=Continia Software\Continia Banking

# Work-item tag that opts an item into script generation (default: "create script")
# CREATE_SCRIPT_TAG=create script

# Tag that also records a narrated demo video and attaches it (default: "create video")
# CREATE_VIDEO_TAG=create video
# OpenAI key for narration (text-to-speech). Required only for video items.
OPENAI_API_KEY=
# Narration locale: en-US, en-GB, da-DK, de-DE, nl-NL, no-NO, sv-SE (default: en-US)
# VIDEO_LOCALE=en-US
# Show the browser while recording (debugging only)
# VIDEO_HEADED=false

# Path to the READ-ONLY continia-banking clone (LSP navigation root + symbol source)
CONTINIA_BANKING_PATH=./continia-banking

# API token for continia.exe (passed as --token; removes the VS Code dependency)
CONTINIA_API_TOKEN=your-continia-token-here

# continia CLI path or command (default: continia, on PATH in Docker).
# Locally on Windows: .tools/continia.exe
# CONTINIA_CLI_PATH=continia

# Optional. Pins the DemoPortal profile. Normally left unset: the pipeline takes the
# highest application/platform version declared by continia-banking's app.json files
# and picks the lowest published profile that satisfies it, in CONTINIA_ENV_LOCALIZATION.
CONTINIA_ENV_PROFILE_ID=
# Localization of the derived profile and of the banking country app (banking-<cc>;
# base uses banking-w1). base, dk, nl, de, gb, us, ... (default: base)
# CONTINIA_ENV_LOCALIZATION=base

# Max minutes to wait for a new environment to reach Running (default: 15)
# ENV_READY_TIMEOUT_MINUTES=15

# Anthropic API key for the agent. Set this to run on API billing (no Claude Code
# OAuth / ~/.claude needed). Leave empty to use the Claude Code OAuth login instead.
ANTHROPIC_API_KEY=

# Writable root for the generated .md recording script (default: ./output)
# WORKSPACE_OUTPUT_DIR=./output

# Writable base path where the PTE AL project is created before publishing.
# Defaults to WORKSPACE_OUTPUT_DIR. MUST be writable and NEVER inside continia-banking.
# PTE_OUTPUT_DIR=./output

# Local path to the marketplace LSP plugin loaded into the agent
LSP_PLUGIN_PATH=

# Polling interval in minutes (default: 5)
# POLL_INTERVAL_MINUTES=5

# Max work items processed in parallel per poll cycle (default: 1 = sequential)
# Values >1 assume the agent's skills don't contend on shared repo-root state;
# only 1 has been verified in production.
# WATCH_CONCURRENCY=1

# Default model and effort for every agent stage (generate, validate, deploy).
# Effort: low | medium | high | xhigh | max (default: the model's own default).
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_EFFORT=

# Per-stage overrides. <STAGE> = GENERATE | VALIDATE | DEPLOY.
# Defaults: max turns 150 / 60 / 80, timeout 60 / 30 / 45 minutes, no budget cap.
# STAGE_GENERATE_MODEL=
# STAGE_GENERATE_EFFORT=
# STAGE_GENERATE_MAX_TURNS=150
# STAGE_GENERATE_MAX_BUDGET_USD=
# STAGE_GENERATE_TIMEOUT_MINUTES=60
