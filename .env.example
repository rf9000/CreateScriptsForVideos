# Azure DevOps Configuration (required)
AZURE_DEVOPS_PAT=your-pat-here
AZURE_DEVOPS_ORG=continia-software
AZURE_DEVOPS_PROJECT=Continia Software

# Comma-separated Git repo GUIDs. Only work items linked (via artifact links)
# to one of these repos are processed. Leave empty to disable the repo filter.
AZURE_DEVOPS_REPO_IDS=a838fce3-3b9c-4c78-beec-cb4cf5983144

# Work-item tag that opts an item into script generation (default: "create script")
# CREATE_SCRIPT_TAG=create script

# Path to the READ-ONLY continia-banking clone (LSP navigation root + symbol source)
CONTINIA_BANKING_PATH=./continia-banking

# API token for continia.exe (passed as --token; removes the VS Code dependency)
CONTINIA_API_TOKEN=your-continia-token-here

# Writable root for the generated .md recording script (default: ./output)
# WORKSPACE_OUTPUT_DIR=./output

# Writable base path where the PTE AL project is created before publishing.
# Defaults to WORKSPACE_OUTPUT_DIR. MUST be writable and NEVER inside continia-banking.
# PTE_OUTPUT_DIR=./output

# Local path to the marketplace LSP plugin loaded into the agent
LSP_PLUGIN_PATH=

# Polling interval in minutes (default: 5)
# POLL_INTERVAL_MINUTES=5

# Max agentic turns for the orchestrator agent (default: 120)
# AGENT_MAX_TURNS=120

# Max processing attempts per work item before giving up (default: 3)
# MAX_PROCESS_ATTEMPTS=3

# Claude model (default: claude-sonnet-4-6; use claude-opus-4-6 for heavier features)
# CLAUDE_MODEL=claude-sonnet-4-6

# Path to the orchestration prompt (default: .claude/commands/create-script.md)
# PROMPT_PATH=.claude/commands/create-script.md

# State file directory (default: .state)
# STATE_DIR=.state
